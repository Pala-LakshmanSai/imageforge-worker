# Non-secret RunPod template settings for the pinned CUDA 13.0 worker image.
# Store the bearer JSON in a RunPod secret;
# do not paste a real value into this file.
IMAGEFORGE_DATA_ROOT=/workspace/imageforge
# Pin this to the deployed container digest; the paid volume gate verifies it.
# IMAGEFORGE_IMAGE_DIGEST=sha256:<immutable-image-digest>
IMAGEFORGE_MODEL_CACHE_DIR=/workspace/models/huggingface
IMAGEFORGE_INFERENCE_BACKEND=flux
IMAGEFORGE_FSYNC_WRITES=1
IMAGEFORGE_RETRY_DELAY_SECONDS=0.25
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DIFFUSERS_OFFLINE=1

# Required secret environment variable (intentionally has no example value):
# IMAGEFORGE_AUTH_TOKENS_JSON
